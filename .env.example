# Copy to .env and fill in. Never commit .env.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Binance Web3 API (RWA Data API + Trading API), from the Binance Web3 developer portal
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Real stock prices (free plan is enough): https://finnhub.io
FINNHUB_API_KEY=

# WalletConnect / Reown project id (cloud.reown.com). Add your domain to its allowlist.
WALLETCONNECT_PROJECT_ID=

# Public HTTPS address of the Mini App (also set in BotFather: /newapp, short name "app", and /setdomain)
WEB_URL=https://your-domain.example

# Autopilot (Binance Agentic Wallet via the baw CLI). Optional: without it, members get Buy buttons instead.
BINANCE_INSTANCE_ID=
# BAW_BIN=/opt/stock-club/tools/node_modules/.bin/baw
# BAW_ROOT=/opt/stock-club/baw

# AI analyst (/ai). Optional: without it the AI features are hidden.
OPENAI_API_KEY=
# AI_MODEL=gpt-5.4-mini

# Optional
# BSC_RPC=https://bsc-dataseed.bnbchain.org
# DB_PATH=data/stock-club.db
# WEB_PORT=8080
