# Main address
stockclubhq.xyz {
	# WalletConnect relay through our server (some ISPs block walletconnect.org)
	handle_path /wc-relay* {
		reverse_proxy https://relay.walletconnect.org {
			header_up Host relay.walletconnect.org
		}
	}
	handle {
		encode gzip
		reverse_proxy 127.0.0.1:8080
	}
}

www.stockclubhq.xyz {
	redir https://stockclubhq.xyz{uri} permanent
}

